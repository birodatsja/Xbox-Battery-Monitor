<Window x:Class="XboxBatteryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox Controller Battery"
        Width="420" Height="400"
        Background="#1E1E1E"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Xbox Controller Battery"
                   Foreground="White" FontSize="22" FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <ItemsControl x:Name="ControllerList" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2B2B2B" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}"
                                           Foreground="{Binding Brush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White" FontSize="15" FontWeight="SemiBold" />
                            </DockPanel>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding Percent, Mode=OneWay}"
                                         Foreground="{Binding Brush}"
                                         Background="#444444" BorderThickness="0"
                                         Height="10" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding Detail}" Foreground="#9A9A9A" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="No controller detected.&#x0A;Turn it on and make sure it is paired over Bluetooth."
                   Foreground="#9A9A9A" FontSize="14" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <CheckBox x:Name="StartupBox" Content="Start with Windows"
                      Foreground="#CFCFCF" Margin="0,0,0,6"
                      Click="StartupBox_Click" />
            <TextBlock x:Name="StatusText" Foreground="#6E6E6E" FontSize="11" />
            <TextBlock Text="Closing or minimizing this window keeps the app running in the tray."
                       Foreground="#6E6E6E" FontSize="11" />
        </StackPanel>
    </Grid>
</Window>
